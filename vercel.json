{
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express"
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
      }
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
      }
    }
  ]
}